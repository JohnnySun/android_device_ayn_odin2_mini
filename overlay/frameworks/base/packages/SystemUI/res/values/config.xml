<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The charge control tile belongs in the shade out of the box. Without
         this it exists only for someone who adds it by hand, and Android 16
         seeds its large-tile set from whatever is in this list at first boot,
         so a tile missing here also renders icon-only with no visible label.
         Both lists are set because the classic and the new quick settings UI
         read different ones. -->
    <string name="quick_settings_tiles_default" translatable="false">
        internet,bt,flashlight,dnd,alarm,airplane,controls,wallet,rotation,battery,cast,screenrecord,mictoggle,cameratoggle,custom(com.odin2.odinsettings/.tiles.ChargeBypassTileService),custom(com.android.permissioncontroller/.permission.service.v33.SafetyCenterQsTileService)
    </string>

    <string name="quick_settings_tiles_new_default" translatable="false">
        internet,bt,dnd,cast,flashlight,airplane,rotation,wallet,alarm,controls,screenrecord,battery,custom(com.odin2.odinsettings/.tiles.ChargeBypassTileService)
    </string>
</resources>
