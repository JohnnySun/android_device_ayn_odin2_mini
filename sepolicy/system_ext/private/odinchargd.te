type odinchargd, domain, coredomain;
type odinchargd_exec, system_file_type, exec_type, file_type;

init_daemon_domain(odinchargd)

get_prop(odinchargd, build_prop)
unix_socket_send(odinchargd, logdw, logd)

# The restriction and its current, both relabelled out of the generic sysfs
# type so this is the only domain that can hold charging off.
allow odinchargd odin_charge_control_sysfs:file { open read write };

binder_use(odinchargd)
add_service(odinchargd, odin_charge_service)
binder_call(odinsettings_app, odinchargd)

# Battery capacity is read from the health HAL, not from
# /sys/class/power_supply/battery/capacity. That node carries
# vendor_sysfs_battery_supply, and a coredomain cannot be granted a
# vendor-private type from system_ext policy, so the direct read only ever
# worked because the device was Permissive - 460 denials in one boot. Crossing
# at the HAL is what Treble is for, and this grant is one AOSP macro.
hal_client_domain(odinchargd, hal_health)

# Persisted mode, so a reboot keeps what the user chose. init creates the
# directory; this domain owns the file inside it.
allow odinchargd odin_data_file:dir rw_dir_perms;
allow odinchargd odin_data_file:file create_file_perms;
