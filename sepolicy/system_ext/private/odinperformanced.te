type odinperformanced, domain, coredomain;
type odinperformanced_exec, system_file_type, exec_type, file_type;

init_daemon_domain(odinperformanced)

get_prop(odinperformanced, build_prop)
unix_socket_send(odinperformanced, logdw, logd)

# The screen state the hold loop skips on, which the stock daemon also read.
get_prop(odinperformanced, debug_prop)

# The CPU frequency floors. These keep the generic core label rather than being
# relabelled, because the QTI performance stack owns the same nodes and moving
# them out from under it would be a larger change than this daemon justifies.
allow odinperformanced sysfs_devices_system_cpu:file { open read write };
allow odinperformanced sysfs_devices_system_cpu:dir search;

binder_use(odinperformanced)
add_service(odinperformanced, odin_performance_service)
binder_call(odinsettings_app, odinperformanced)

# Two writes are deliberately not granted here, and both still depend on
# Permissive:
#
# The GPU floor keeps its vendor label, vendor_sysfs_kgsl, and a coredomain
# cannot be granted a vendor-private type from here. Same shape as the battery
# capacity read in odinchargd.te, and both belong with the Qualcomm vendor
# policy work before whole-device Enforcing.
#
# The stored mode lives at /data/system/odin-performance-mode, and AOSP
# neverallows any domain writing system_data_file, so granting it here does not
# compile. odinchargd has the same gap for the same reason. Closing it means
# moving both state files somewhere the daemons can own, with a type of their
# own, which is a change to where persisted state lives rather than a policy
# line, and belongs with the Enforcing work rather than ahead of it.

# Persisted mode, so a reboot keeps what the user chose. init creates the
# directory; this domain owns the file inside it.
allow odinperformanced odin_data_file:dir rw_dir_perms;
allow odinperformanced odin_data_file:file create_file_perms;
