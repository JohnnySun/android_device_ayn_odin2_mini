# The Odin2 Mini has a dedicated Back button. Keep the east face button as a
# gamepad B event instead of inheriting Generic.kcm's BUTTON_B -> BACK fallback.

type FULL

key BUTTON_A {
    base:                               fallback DPAD_CENTER
}

key BUTTON_B {
    base:                               none
}

key BUTTON_X {
    base:                               fallback DEL
}

key BUTTON_Y {
    base:                               fallback SPACE
}
